{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Geracao de ISS Saida e Tomador",
  "version": "1.0.0",
  "identifier": "com.kaua.automacao",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Geracao de ISS Saida e Tomador todas as empresas",
        "width": 680,
        "height": 440,
        "minWidth": 680,
        "minHeight": 440,
        "resizable": false,
        "center": true
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
