{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowDetect Studio",
  "version": "3.0.2",
  "identifier": "com.kaua.gerador",
  "mainBinaryName": "FlowDetect",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlowDetect Studio",
        "width": 1380,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../../capturar_cliques.py": "capturar_cliques.py",
      "../../capturar_imagem_tela.py": "capturar_imagem_tela.py",
      "../../chrome_web_bridge.py": "chrome_web_bridge.py",
      "../../diagnostico_ambiente.py": "diagnostico_ambiente.py",
      "../../executar_automacao.py": "executar_automacao.py",
      "../../scripts/runtime/executar_automacao.bat": "executar_automacao.bat",
      "../../reconhecimento_worker.py": "reconhecimento_worker.py",
      "../../gerenciar_roteiro.py": "gerenciar_roteiro.py",
      "../../gerenciar_dados_planilha.py": "gerenciar_dados_planilha.py",
      "../../listar_janelas_abertas.py": "listar_janelas_abertas.py",
      "../../overlay_janela_alvo.py": "overlay_janela_alvo.py",
      "../../overlay_automacao_tela.py": "overlay_automacao_tela.py",
      "installer_support/runtime_seed/comandos_teclado.py": "comandos_teclado.py",
      "../../validar_dependencias_instaladas.py": "validar_dependencias_instaladas.py",
      "../../requirements.txt": "requirements.txt",
      "../../scripts/runtime/instalar_dependencias_silencioso.bat": "instalar_dependencias_silencioso.bat",
      "../../hyperv_setup/Preparar-FlowDetectHyperV.ps1": "hyperv_setup/Preparar-FlowDetectHyperV.ps1",
      "../../hyperv_setup/golden-vm.json": "hyperv_setup/golden-vm.json",
      "../../hyperv_setup/README.md": "hyperv_setup/README.md",
      "installer_support/python-installer.exe": "python-installer.exe",
      "installer_support/python-wheels/": "python-wheels/",
      "installer_support/Tesseract-OCR/": "Tesseract-OCR/",
      "installer_support/runtime_seed/mapeamento_teclado.json": "mapeamento_teclado.json",
      "installer_support/runtime_seed/resumo_teclado.txt": "resumo_teclado.txt",
      "installer_support/runtime_seed/automacoes/": "automacoes/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "installMode": "currentUser",
        "startMenuFolder": "FlowDetect Studio",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer_assets/flowdetect_studio_header.bmp",
        "uninstallerHeaderImage": "installer_assets/flowdetect_studio_header.bmp",
        "sidebarImage": "installer_assets/flowdetect_studio_sidebar.bmp",
        "installerHooks": "installer_assets/flowdetect_hooks.nsh"
      }
    }
  }
}
