{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gerador de Automacoes",
  "version": "1.0.0",
  "identifier": "com.kaua.gerador",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gerador visual de automacoes",
        "width": 1460,
        "height": 920,
        "minWidth": 1280,
        "minHeight": 820,
        "resizable": true,
        "center": true
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
