{
  "manifest_version": 3,
  "name": "FlowDetect para Chrome",
  "description": "Executa automacoes web exportadas pelo FlowDetect Studio.",
  "version": "0.2.12",
  "permissions": ["activeTab", "sidePanel", "scripting", "storage", "unlimitedStorage", "debugger"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir FlowDetect"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
