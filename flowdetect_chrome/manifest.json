{
  "manifest_version": 3,
  "name": "FlowDetect para Chrome",
  "description": "Executa automacoes web exportadas pelo FlowDetect Studio.",
  "version": "0.2.17",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir FlowDetect",
    "default_popup": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
