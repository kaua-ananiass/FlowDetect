{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowDetect Control",
  "version": "1.0.0",
  "identifier": "com.kaua.flowdetectcontrol",
  "mainBinaryName": "FlowDetectControl",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlowDetect Control",
        "width": 1380,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../../tauri_gerador/src-tauri/icons/icon.ico"
    ]
  }
}
